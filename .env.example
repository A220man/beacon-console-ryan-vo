# Beacon Console Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# APPLICATION
# =============================================================================
ENVIRONMENT=development
DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000

# Database (SQLite for local dev, PostgreSQL for production)
# SQLite: sqlite+aiosqlite:///./beacon.db
# PostgreSQL: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./beacon.db

# Redis (for sessions, rate limiting)
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# SECURITY
# =============================================================================
# Generate with: openssl rand -base64 32
SECRET_KEY=your-super-secret-key-min-32-chars-long
CSRF_SECRET=your-csrf-secret-min-32-chars-long

# Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# OIDC / KEYCLOAK
# =============================================================================
OIDC_ENABLED=true
OIDC_ISSUER_URL=http://localhost:8080/realms/beacon
OIDC_CLIENT_ID=beacon-console
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
OIDC_SCOPES=openid profile email roles
OIDC_LOGOUT_REDIRECT_URI=http://localhost:3000/

# =============================================================================
# LLM (Optional - for AI explanations)
# =============================================================================
# Supported providers: openai-compatible, anthropic, gemini, ollama
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# DOCKER COMPOSE OVERRIDES
# =============================================================================
# PostgreSQL
POSTGRES_PASSWORD=beacon_dev_password

# Keycloak
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_PASSWORD=keycloak_dev_password